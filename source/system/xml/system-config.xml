<groupdef id="studio.configgroup.bg">
  <grid
    id="config.item.grid"
    x="0" y="0"
    w="0" h="0"
    relatw="1" relath="1"
    topleft="studio.label.upperLeft"
    top="studio.label.top"
    topright="studio.label.upperRight"
    left="studio.label.left"
    middle="studio.label.middle"
    right="studio.label.right"
    bottomleft="studio.label.lowerLeft"
    bottom="studio.label.bottom"
    bottomright="studio.label.lowerRight"
  />
</groupdef>

<groupdef id="studio.configgroup.std" default_h="16">

 <group id="studio.configgroup.bg" 
  x="0" y="0" w="0" h="0" relatw="1" relath="1" 
 />

 <text
  id="cfg.txt"
  x="0" y="0"
  w="-45" h="16" relatw="1"
  fontsize="14"
  color="248,248,248"
  shadowx="1" shadowy="1"
 />

</groupdef>


<groupdef id="studio.configgroup.int" inherit_group="studio.configgroup.std">

 <edit 
  id="cfg.edit"
  x="-45" y="0"
  w="45" h="16" 
  relatx="1"
 />

 <button id="cfg.toggle2" x="0" y="0"
  w="0" relatw="1" h="0" relath="1"
 />

 <script id="cfg.int" file="system/scripts/cfgint.maki"/>

</groupdef>


<groupdef id="studio.configgroup.bool" inherit_group="studio.configgroup.std">

 <togglebutton
  id="cfg.toggle"
  x="-16" y="3" relatx="1"
  image="studio.button.checkbox.unchecked"
  activeImage="studio.button.checkbox.checked"
 />

 <button id="cfg.toggle2" x="0" y="0"
  w="0" relatw="1" h="0" relath="1"
 />
 <script id="cfg.bool" file="system/scripts/cfgbool.maki"/>

</groupdef>

<groupdef id="studio.configgroup.string" default_h="16" inherit_group="studio.configgroup.std">

 <edit
  id="cfg.edit"
  x="-150" y="0" relatx="1"
  w="150" h="16"
 />
 <script id="cfg.string" file="system/scripts/cfgstring.maki"/>

 <button id="cfg.toggle2" x="0" y="0"
  w="0" relatw="1" h="0" relath="1"
 />

</groupdef>

<groupdef id="studio.configgroup.float" default_h="16" inherit_group="studio.configgroup.std">

 <edit
  id="cfg.edit"
  x="-150" y="0" relatx="1"
  w="150" h="16"
 />

 <button id="cfg.toggle2" x="0" y="0"
  w="0" relatw="1" h="0" relath="1"
 />
 <script id="cfg.float" file="system/scripts/cfgfloat.maki"/>

</groupdef>
