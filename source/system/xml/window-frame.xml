   />
   <layer
     id="window.left.line.status"
     x="14" y="-30"
     h="16"
     relaty="1"
     image="48dot"
   />
   <layer
     id="window.right.line.status"
     x="-15" y="-30"
     h="16"
     relatx="1"
     relaty="1"
     image="48dot"
   /> 


  <LayoutStatus id="standardframe.layoutstatus" x="15" y="-30" relaty="1" w="-30" relatw="1" h="15" exclude="{system}" />
  <SysCmds id="syscmds" />
  <script id="standardframe.script" file="system/scripts/standardframe.maki" param="15,22,-30,-52,0,0,1,1" />

</groupdef>

