<groupdef id="wasabi.frame.layout" background="component.basetexture">

   <layer
     id="hide-the-other-color"
     x="9" y="9"
     h="-20" w="-20"
     relatw="1" relath="1"
     image="128dot"
   />


   <layer
     id="window.top.left"
     x="0" y="0"
     image="component.window.top.left"
     resize="topleft"
   />
   <layer
     id="window.top"
     x="22" y="0"
     w="-44"
     relatw="1"
     image="component.window.top"
     resize="top"
   />
   <layer
     id="window.top.right"
     x="-22" y="0"
     relatx="1"
     image="component.window.top.right"
     resize="topright"
   />

   <layer
     id="window.left"
     x="0" y="22"
     h="-22"
     relath="1"
     image="component.window.left"
     resize="left"
   />
   <layer
     id="window.right"
     x="-22" y="22"
     h="-22"
     relatx="1" relath="1"
     image="component.window.right"
     resize="right"
   />



<!-- INNER-->
   <layer
     id="window.top.left.inner"
     x="0" y="0"
     image="component.window.top.left.inner"
     resize="topleft"
   />
   <layer
     id="window.top.inner"
     x="22" y="0"
     w="-44"
     relatw="1"
     image="component.window.top.inner"
     resize="top"
   />
   <layer
     id="window.top.right.inner"
     x="-22" y="0"
     relatx="1"
     image="component.window.top.right.inner"
     resize="topright"
   />

   <layer
     id="window.left.inner"
     x="0" y="22"
     h="-22"
     relath="1"
     image="component.window.left.inner"
     resize="left"
   />
   <layer
     id="window.right.inner"
     x="-22" y="22"
     h="-22"
     relatx="1" relath="1"
     image="component.window.right.inner"
     resize="right"
   />

<!-- Mask-->

   <layer
     id="window.top.left.mask"
     x="0" y="0"
     image="component.window.top.left.mask"
     resize="topleft"
     sysregion="-2"
   />
   <layer
     id="window.top.mask"
     x="22" y="0"
     w="-44"
     relatw="1"
     image="component.window.top.mask"
     resize="top"
     sysregion="-2"
   />
   <layer
     id="window.top.right.mask"
     x="-22" y="0"
     relatx="1"
     image="component.window.top.right.mask"
     resize="topright"
     sysregion="-2"
   />

   <layer
     id="window.left.mask"
     x="0" y="22"
     h="-22"
     relath="1"
     image="component.window.left.mask"
     resize="left"
     sysregion="-2"
   />
   <layer
     id="window.right.mask"
     x="-21" y="22"
     h="-22"
     relatx="1" relath="1"
     image="component.window.right.mask"
     resize="right"
     sysregion="-2"
   />


<!-- LINES -->

   <layer
     id="window.top.line"
     x="15" y="21"
     w="-30"
     relatw="1"
     image="48dot"
   />
   <layer
     id="window.left.line"
     x="14" y="21"
     h="-32"
     relath="1"
     image="48dot"
   />
   <layer
     id="window.right.line"
     x="-15" y="21"
     h="-32"
     relatx="1" relath="1"
     image="48dot"
   /> 

   <layer id="window.resize.disabler" x="5" y="5" w="-10" h="-10" relatw="1" relath="1"/>
   
   <LayoutStatus id="sysmenu.status" bg="0" x="18" y="12" w="9" h="9" includeonly="{system}" />
   <hideobject target="sysmenu.status"/>

   <button
      id="CONTROLMENU"
      action="CONTROLMENU"
      x="18" y="12"
      image="wasabi.button.sysmenu"
      downImage="wasabi.button.sysmenu.pressed"
      tooltip="Configure"
      rectrgn="1"
   />

   <button
      id="Close"
      action="CLOSE"
      x="-25" y="12"
      relatx="1"
      image="wasabi.button.close"
      downImage="wasabi.button.close.pressed"
      tooltip="Close Window"
      rectrgn="1"
   />
   <group
     id="wasabi.titlebar"
     x="30" y="6"
     w="-60" h="15"
     relatw="1"
   />
     
 </groupdef>

 <groupdef id="wasabi.standardframe.statusbar">

    <group id="wasabi.frame.layout" x="0" y="0" w="0" relatw="1" h="-19" relath="1"/>

   <layer
     id="window.bottom.left"
