<include file="pledit-elements.xml" />

  <container id="Pledit" name="Playlist Editor" component="guid:{45F3F7C1-A6F3-4ee6-A15E-125E92FC3F8D}" default_x="180" default_y="0" default_visible="1">

   <!-- This is the group we will insert inside the standard frame -->

   <groupdef id="pledit.content.group">

    <component
      x="0"
      y="0"
      w="0"
      relatw="1"
      h="0"
      relath="1"
      noshowcmdbar="1"
      autoopen="1"
      autoclose="1"
      param="guid:{45F3F7C1-A6F3-4ee6-A15E-125E92FC3F8D}"
    />

   </groupdef>
   
   <!-- Our actual layout, composed of a standard frame with some content (see above) -->

   <layout id="normal" background="component.basetexture" desktopalpha="0" minimum_h="116" minimum_w="275" default_h="350" default_w="325" linkwidth="shade">

     <!-- the notify tells the standardframe to put this group inside its client area -->
     <group id="wasabi.standardframe.statusbar" 
      x="0" y="0" w="0" h="0" relatw="1" relath="1" 
      notify="content,pledit.content.group" 
      notify1="padtitleright,18" 
      notify2="shade,shade" 
     />
     

   </layout>

   

  </container>
